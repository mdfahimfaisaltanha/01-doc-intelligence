# PostgreSQL connection string (Neon/Supabase free tier works)
DATABASE_URL=postgres://user:password@localhost:5432/doc_intelligence

# OPTIONAL — leave empty for full mock mode (deterministic hashed embeddings,
# heuristic re-ranker, extractive answers). Set a key to use
# text-embedding-3-small + gpt-4o-mini for embeddings, re-ranking, and answers.
OPENAI_API_KEY=

# Re-rank score floor (0-100). Below this, DocMind refuses instead of guessing.
RERANK_FLOOR=35

# Password used for the seeded users (scripts/setup.mjs)
SEED_PASSWORD=ChangeMe123!
